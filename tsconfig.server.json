{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "server/demo/**/*.ts",
    "server/http/**/*.ts",
    "server/domain/**/*.ts",
    "server/modules/dabo/dabo-api.service.ts",
    "server/modules/dabo/csv.ts",
    "server/modules/dabo/identity.ts",
    "server/runtime/config.ts",
    "shared/**/*.ts"
  ]
}
