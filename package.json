{
  "name": "creator-operations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Creator operations workbench with deterministic local demo and independently usable Creator Assistant",
  "license": "MIT",
  "author": "xiaoyu312",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "demo": "node --experimental-transform-types examples/demo.ts",
    "demo:assistant": "node examples/assistant-demo.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts server/tests/*.test.ts",
    "test:assistant": "node --test extensions/creator-assistant/tests/*.test.mjs",
    "build:assistant": "node extensions/creator-assistant/build.mjs",
    "dev:client": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --config vite.config.ts",
    "build:client": "vite build --config vite.config.ts",
    "typecheck:client": "tsc --project tsconfig.app.json --noEmit",
    "dev": "node --env-file-if-exists=.env tools/dev.mjs",
    "start": "node --env-file-if-exists=.env tools/dev.mjs --preview",
    "dev:server": "node --env-file-if-exists=.env --experimental-transform-types server/demo/main.ts",
    "test:server": "node --experimental-transform-types --test server/tests/*.test.ts",
    "generate:demo": "node --experimental-transform-types examples/generate-demo.ts",
    "typecheck:server": "tsc --project tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "build": "npm run build:client && npm run build:assistant"
  },
  "dependencies": {
    "@lark-apaas/client-toolkit": "1.2.74",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/typography": "0.5.20",
    "@tanstack/react-query": "5.102.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "crypto-js": "4.2.0",
    "date-fns": "4.4.0",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.4",
    "react-router-dom": "7.18.3",
    "recharts": "2.15.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/crypto-js": "4.2.2",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "@types/express": "5.0.6"
  },
  "peerDependencies": {
    "@nestjs/common": "10.4.22",
    "@lark-apaas/fullstack-nestjs-core": "1.1.66",
    "drizzle-orm": "0.44.6",
    "express": "4.22.2"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@lark-apaas/fullstack-nestjs-core": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  }
}
