# Optional local API settings. Defaults require no environment file.
DABO_MODE=demo
DABO_DEMO_API_PORT=4310
DABO_ENABLE_PLATFORM=0

# Optional platform integration only; all deployment-specific values stay blank.
# The local demo refuses production mode and never registers these adapters.
DABO_EXPECTED_APP_ID=
DABO_ORG_ID=
DABO_ROLE_MAPPING=
DABO_IMPORT_PREVIEW_SECRET=
DABO_APP_MODE=
DABO_WORKBOOK_ROLE_MAPPING=
DABO_WORKBOOK_STORE_TOKEN=
DABO_MEMBER_INVITATIONS_ENABLED=0
DABO_MEMBER_INVITATIONS_SCOPE_REVIEWED=0
